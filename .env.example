# RetentionDoctor Configuration

# Server
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database (Default: local SQLite; replace with Supabase/PostgreSQL for production connection pooling)
DATABASE_URL=sqlite:///./retention_doctor.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Authentication
JWT_SECRET=retention-doctor-dev-secret-key-2026
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Unified Cloud Storage (Default: 'local'; supports 's3' for AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET_NAME=retention-doctor-uploads
S3_ENDPOINT_URL=

# Domestic Payments (Razorpay - India / UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# International Payments (Stripe - Global Card / Apple Pay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Processing Limits (Production Safe Defaults)
MAX_UPLOAD_SIZE_MB=250
MAX_VIDEO_DURATION_SEC=300
